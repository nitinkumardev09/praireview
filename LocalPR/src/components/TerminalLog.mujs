<mu>
import { muState } from '@mulanjs/mulanjs';

state = muState({
    logs: '',
    status: 'IDLE'
});

appendLog(text) ->
    state.logs += (state.logs ? '\n' : '') + text;

setLogs(text) ->
    state.logs = text;

setStatus(s) ->
    state.status = s;

clear() ->
    state.logs = '';
    state.status = 'IDLE';
</mu>
<mu-template>
  <div class="terminal-window">
    <div class="terminal-header">
      <div class="terminal-dots">
        <span class="terminal-dot dot-red"></span>
        <span class="terminal-dot dot-yellow"></span>
        <span class="terminal-dot dot-green"></span>
        <span class="terminal-title">Runner Console (Port 1017)</span>
      </div>
      <div class="terminal-actions">
        <span class="${'status-tag ' + (state.status === 'RUNNING' ? 'tag-running' : (state.status === 'SUCCESS' ? 'tag-success' : 'tag-idle'))}">
          ${state.status}
        </span>
        <button class="term-btn" mu-click="clear()">Clear</button>
      </div>
    </div>
    <div class="terminal-body" id="runner-terminal-body">
      <div class="terminal-placeholder" mu-if="!state.logs">
        Runner idle. Click 'Download & Run Test Pipeline' to execute build, tests, and coverage analysis.
      </div>
      <pre class="terminal-text" mu-if="state.logs">${state.logs}</pre>
    </div>
  </div>
</mu-template>
<style scoped>
.terminal-window {
  background: #08090f;
  border: 1px solid #1f2333;
  border-radius: 8px;
  overflow: hidden;
}
.terminal-header {
  background: #10131d;
  padding: 10px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #1f2333;
}
.terminal-dots {
  display: flex;
  align-items: center;
  gap: 8px;
}
.terminal-dot {
  width: 11px;
  height: 11px;
  border-radius: 50%;
}
.dot-red { background: #ef4444; }
.dot-yellow { background: #f59e0b; }
.dot-green { background: #10b981; }
.terminal-title {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.8rem;
  color: #94a3b8;
  margin-left: 6px;
}
.terminal-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}
.status-tag {
  font-size: 0.72rem;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 4px;
}
.tag-idle { background: #1e2233; color: #94a3b8; }
.tag-running { background: rgba(0, 240, 255, 0.2); color: #00f0ff; animation: pulse 1.5s infinite; }
.tag-success { background: rgba(5, 213, 80, 0.2); color: #05d550; }
.term-btn {
  background: #1a1e2d;
  border: 1px solid #2d3348;
  color: #cbd5e1;
  padding: 3px 10px;
  border-radius: 4px;
  font-size: 0.75rem;
  cursor: pointer;
}
.term-btn:hover {
  background: #252b40;
}
.terminal-body {
  padding: 18px;
  min-height: 260px;
  max-height: 480px;
  overflow-y: auto;
  font-family: 'JetBrains Mono', Consolas, monospace;
  font-size: 0.86rem;
  line-height: 1.55;
  background: #06070a;
}
.terminal-placeholder {
  color: #4b5563;
  font-style: italic;
  padding: 20px 0;
}
.terminal-text {
  color: #e2e8f0;
  white-space: pre-wrap;
  word-break: break-all;
}
</style>
