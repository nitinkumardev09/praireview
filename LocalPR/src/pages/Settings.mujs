<mu>
import { muState } from '@mulanjs/mulanjs';
import { AIReviewerService } from '../services/ai-reviewer';
import { GitHubService } from '../services/github';
import { DEFAULT_STANDARDS } from '../services/standards';

const state = muState({
    githubToken: GitHubService.getToken(),
    copilotKey: (typeof localStorage !== 'undefined' ? localStorage.getItem('mulan_copilot_key') || '' : ''),
    ollamaEndpoint: 'http://localhost:11434',
    ollamaModel: 'qwen2.5-coder:latest',
    lmStudioEndpoint: 'http://localhost:1234/v1',
    openaiKey: (typeof localStorage !== 'undefined' ? localStorage.getItem('mulan_openai_key') || '' : ''),
    claudeKey: (typeof localStorage !== 'undefined' ? localStorage.getItem('mulan_claude_key') || '' : ''),
    standards: DEFAULT_STANDARDS,
    testStatus: null,
    savedNotice: false
});

function saveSettings() {
    GitHubService.setToken(state.githubToken);
    AIReviewerService.saveKey('mulan_copilot_key', state.copilotKey);
    AIReviewerService.saveKey('mulan_openai_key', state.openaiKey);
    AIReviewerService.saveKey('mulan_claude_key', state.claudeKey);
    state.savedNotice = true;
    setTimeout(() => { state.savedNotice = false; }, 3000);
}

function testConnection(providerType) {
    state.testStatus = { loading: true, provider: providerType, message: 'Testing connection...' };
    
    const provider = {
        type: providerType,
        name: providerType,
        endpoint: providerType === 'ollama' ? state.ollamaEndpoint : (providerType === 'copilot' ? 'https://models.inference.ai.azure.com' : state.lmStudioEndpoint),
        model: providerType === 'ollama' ? state.ollamaModel : 'gpt-4o',
        apiKey: providerType === 'copilot' ? state.copilotKey : (providerType === 'openai' ? state.openaiKey : ''),
        description: '',
        isLocal: providerType === 'ollama' || providerType === 'lmstudio' || providerType === 'builtin'
    };

    AIReviewerService.testConnection(provider).then((res) => {
        state.testStatus = {
            loading: false,
            provider: providerType,
            success: res.success,
            message: res.message
        };
    }).catch((err) => {
        state.testStatus = {
            loading: false,
            provider: providerType,
            success: false,
            message: err.message
        };
    });
}

function toggleStandard(id) {
    const std = state.standards.find(s => s.id === id);
    if (std) {
        std.enabled = !std.enabled;
    }
}
</mu>
<mu-template>
  <div class="page container">
    <div class="settings-header">
      <div class="hero-badge">⚙️ AI Providers & Enterprise Standards</div>
      <h1 class="hero-title">AI Engine Settings</h1>
      <p class="hero-subtitle">
        Configure online and local AI models (GitHub Copilot, Ollama, LM Studio, Claude, OpenAI) and enterprise review standards.
      </p>
    </div>

    <!-- Save notification -->
    <div class="save-toast" mu-if="state.savedNotice">
      ✅ Settings saved securely in local storage!
    </div>

    <!-- Connection Test Status Banner -->
    <div 
      class="${'test-status-banner ' + (state.testStatus.success ? 'status-ok' : 'status-err')}" 
      mu-if="state.testStatus"
    >
      <span>${state.testStatus.success ? '🟢' : '🔴'}</span>
      <span><strong>[${state.testStatus.provider.toUpperCase()}]:</strong> ${state.testStatus.message}</span>
    </div>

    <div class="settings-grid">
      <!-- Section 1: GitHub Integration -->
      <div class="mu-card">
        <div class="mu-card-title">
          <span>🐙 GitHub Access & Rate Limits</span>
        </div>
        <div class="form-group">
          <label class="form-label">
            <span>Personal Access Token (PAT)</span>
            <span class="label-sub">Optional for public repos, required for private</span>
          </label>
          <input 
            type="password" 
            class="form-input" 
            placeholder="ghp_xxxxxxxxxxxxxxxxxxxx" 
            value="${state.githubToken}" 
            mu-input="state.githubToken = $event.target.value" 
          >
        </div>
        <div class="token-help">
          Increases GitHub API limit from 60 requests/hr to 5,000 requests/hr.
        </div>
      </div>

      <!-- Section 2: GitHub Copilot & GitHub Models -->
      <div class="mu-card">
        <div class="mu-card-title">
          <span>🤖 GitHub Copilot / Models API</span>
        </div>
        <div class="form-group">
          <label class="form-label">GitHub Models / Copilot Token</label>
          <input 
            type="password" 
            class="form-input" 
            placeholder="GitHub token with Models access" 
            value="${state.copilotKey}" 
            mu-input="state.copilotKey = $event.target.value" 
          >
        </div>
        <div class="model-row">
          <span class="model-tag">Models: GPT-4o, Claude 3.5 Sonnet, o1-mini</span>
          <button class="mu-btn mu-btn-sm mu-btn-secondary" mu-click="testConnection('copilot')">
            Test Copilot
          </button>
        </div>
      </div>

      <!-- Section 3: Local AI (Ollama) -->
      <div class="mu-card">
        <div class="mu-card-title">
          <span>🦙 Local AI: Ollama Engine</span>
        </div>
        <div class="form-group">
          <label class="form-label">Ollama Host URL</label>
          <input 
            type="text" 
            class="form-input" 
            value="${state.ollamaEndpoint}" 
            mu-input="state.ollamaEndpoint = $event.target.value" 
          >
        </div>
        <div class="form-group">
          <label class="form-label">Model Identifier</label>
          <input 
            type="text" 
            class="form-input" 
            placeholder="qwen2.5-coder:latest or deepseek-coder-v2" 
            value="${state.ollamaModel}" 
            mu-input="state.ollamaModel = $event.target.value" 
          >
        </div>
        <div class="model-row">
          <span class="model-tag">100% Offline & Private</span>
          <button class="mu-btn mu-btn-sm mu-btn-secondary" mu-click="testConnection('ollama')">
            Test Ollama
          </button>
        </div>
      </div>

      <!-- Section 4: Local AI (LM Studio) -->
      <div class="mu-card">
        <div class="mu-card-title">
          <span>🖥️ Local AI: LM Studio</span>
        </div>
        <div class="form-group">
          <label class="form-label">LM Studio Server Endpoint</label>
          <input 
            type="text" 
            class="form-input" 
            value="${state.lmStudioEndpoint}" 
            mu-input="state.lmStudioEndpoint = $event.target.value" 
          >
        </div>
        <div class="model-row">
          <span class="model-tag">Local OpenAI-compatible API</span>
          <button class="mu-btn mu-btn-sm mu-btn-secondary" mu-click="testConnection('lmstudio')">
            Test LM Studio
          </button>
        </div>
      </div>

      <!-- Section 5: Cloud AI Providers -->
      <div class="mu-card">
        <div class="mu-card-title">
          <span>☁️ Cloud AI APIs (OpenAI & Claude)</span>
        </div>
        <div class="form-group">
          <label class="form-label">OpenAI API Key</label>
          <input 
            type="password" 
            class="form-input" 
            placeholder="sk-proj-xxxxxxxx" 
            value="${state.openaiKey}" 
            mu-input="state.openaiKey = $event.target.value" 
          >
        </div>
        <div class="form-group">
          <label class="form-label">Anthropic Claude API Key</label>
          <input 
            type="password" 
            class="form-input" 
            placeholder="sk-ant-xxxxxxxx" 
            value="${state.claudeKey}" 
            mu-input="state.claudeKey = $event.target.value" 
          >
        </div>
      </div>

      <!-- Section 6: Review Standards -->
      <div class="mu-card flex-wide-col">
        <div class="mu-card-title">
          <span>📋 Enterprise Code Review Standards & Rules</span>
        </div>
        <div class="standards-list">
          <div 
            class="standard-item" 
            mu-for="std in state.standards"
          >
            <div class="standard-left">
              <input 
                type="checkbox" 
                class="std-checkbox" 
                checked="${std.enabled}"
                mu-change="toggleStandard(std.id)"
              >
              <div>
                <div class="std-name-row">
                  <span class="std-name">${std.name}</span>
                  <span class="${'severity-badge severity-' + std.severity.toLowerCase()}">${std.severity}</span>
                  <span class="std-cat">[${std.category.toUpperCase()}]</span>
                </div>
                <div class="std-desc">${std.description}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Save Action Bar -->
    <div class="save-bar">
      <button class="mu-btn mu-btn-primary" mu-click="saveSettings()">
        💾 Save All Settings
      </button>
    </div>
  </div>
</mu-template>
<style scoped>
.settings-header {
  text-align: center;
  padding: 30px 10px 20px;
}
.save-toast {
  background: rgba(5, 213, 80, 0.15);
  border: 1px solid rgba(5, 213, 80, 0.4);
  color: #05d550;
  padding: 12px 20px;
  border-radius: 8px;
  margin-bottom: 20px;
  text-align: center;
  font-weight: 700;
}
.test-status-banner {
  padding: 12px 18px;
  border-radius: 8px;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 0.9rem;
}
.status-ok {
  background: rgba(5, 213, 80, 0.1);
  border: 1px solid rgba(5, 213, 80, 0.35);
  color: #86efac;
}
.status-err {
  background: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.35);
  color: #fca5a5;
}
.settings-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 30px;
}
.flex-wide-col {
  grid-column: span 2;
}
.label-sub {
  font-size: 0.72rem;
  color: #64748b;
}
.token-help {
  font-size: 0.78rem;
  color: #64748b;
  margin-top: 4px;
}
.model-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10px;
}
.model-tag {
  font-size: 0.75rem;
  color: #94a3b8;
}
.standards-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.standard-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  background: #141724;
  border-radius: 6px;
  border: 1px solid rgba(255, 255, 255, 0.05);
}
.standard-left {
  display: flex;
  align-items: center;
  gap: 14px;
}
.std-checkbox {
  width: 18px;
  height: 18px;
  accent-color: #ff2a6d;
  cursor: pointer;
}
.std-name-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 2px;
}
.std-name {
  font-weight: 700;
  color: #fff;
  font-size: 0.92rem;
}
.std-cat {
  font-size: 0.72rem;
  color: #38bdf8;
  font-weight: 700;
}
.std-desc {
  font-size: 0.8rem;
  color: #94a3b8;
}
.save-bar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 40px;
}
</style>
