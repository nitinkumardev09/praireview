<mu>
import { muState } from '@mulanjs/mulanjs';

const headerState = muState({
    currentTheme: (typeof localStorage !== 'undefined' && localStorage.getItem('mulan_theme')) || 'light',
    currentRoute: (typeof window !== 'undefined' && window.location.hash) || '#/'
});

if (typeof window !== 'undefined') {
    window.addEventListener('hashchange', () => {
        headerState.currentRoute = window.location.hash || '#/';
    });
}

if (typeof document !== 'undefined') {
    if (headerState.currentTheme === 'dark') {
        document.body.classList.add('theme-dark');
        document.body.classList.remove('theme-light');
    } else {
        document.body.classList.add('theme-light');
        document.body.classList.remove('theme-dark');
    }
}

function toggleTheme() {
    if (headerState.currentTheme === 'light') {
        headerState.currentTheme = 'dark';
        if (typeof document !== 'undefined') {
            document.body.classList.add('theme-dark');
            document.body.classList.remove('theme-light');
            localStorage.setItem('mulan_theme', 'dark');
        }
    } else {
        headerState.currentTheme = 'light';
        if (typeof document !== 'undefined') {
            document.body.classList.add('theme-light');
            document.body.classList.remove('theme-dark');
            localStorage.setItem('mulan_theme', 'light');
        }
    }
}

function getThemeButtonText() {
    return headerState.currentTheme === 'light' ? '🌙 Dark Mode' : '☀️ Enterprise Light';
}

function getNavLinkClass(path) {
    const cur = headerState.currentRoute || '#/';
    const isActive = path === '#/' ? (cur === '#/' || cur === '' || cur === '#') : cur.startsWith(path);
    return 'supabase-tab-link ' + (isActive ? 'active' : '');
}
</mu>
<mu-template>
  <header class="supabase-header">
    <div class="supabase-header-left">
      <!-- Supabase-style Brand Logo -->
      <a href="#/" class="supabase-logo-mark" aria-label="MulanPR Studio">
        <svg class="brand-svg" width="35" height="35" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="60" cy="60" r="40" fill="#FF4081" opacity="0.07"></circle>
          <g>
            <ellipse cx="60" cy="30" rx="15" ry="25" fill="#E91E63" opacity=".88"></ellipse>
            <ellipse cx="60" cy="90" rx="15" ry="25" fill="#E91E63" opacity=".88"></ellipse>
            <ellipse cx="30" cy="60" rx="25" ry="15" fill="#9C27B0" opacity=".88"></ellipse>
            <ellipse cx="90" cy="60" rx="25" ry="15" fill="#9C27B0" opacity=".88"></ellipse>
          </g>
          <g transform="rotate(45 60 60)">
            <ellipse cx="60" cy="30" rx="15" ry="25" fill="#2196F3" opacity=".88"></ellipse>
            <ellipse cx="60" cy="90" rx="15" ry="25" fill="#2196F3" opacity=".88"></ellipse>
            <ellipse cx="30" cy="60" rx="25" ry="15" fill="#3F51B5" opacity=".88"></ellipse>
            <ellipse cx="90" cy="60" rx="25" ry="15" fill="#3F51B5" opacity=".88"></ellipse>
          </g>
          <circle cx="60" cy="60" r="15" fill="#FFC107"></circle>
          <rect x="55" y="55" width="10" height="3" fill="#000" opacity=".55"></rect>
          <rect x="55" y="60" width="5" height="3" fill="#000" opacity=".55"></rect>
          <rect x="55" y="65" width="10" height="3" fill="#000" opacity=".55"></rect>
          <circle cx="45" cy="45" r="2.5" fill="#FF9800"></circle>
          <circle cx="75" cy="45" r="2.5" fill="#FF9800"></circle>
          <circle cx="45" cy="75" r="2.5" fill="#FF9800"></circle>
          <circle cx="75" cy="75" r="2.5" fill="#FF9800"></circle>
        </svg>
      </a>

      <!-- Minimal Project Breadcrumbs -->
      <div class="supabase-breadcrumbs">
        <span class="supabase-org-name">praireview</span>
        <span class="supabase-sep">/</span>
        <span class="supabase-project-name">ai-pr-engine</span>
        <span class="supabase-env-badge">STUDIO</span>
      </div>

      <!-- Minimal Supabase Studio Nav: 3 Tool Pages + 1 About Page -->
      <nav class="supabase-nav-tabs">
        <a href="#/" class="${getNavLinkClass('#/')}">⚡ Cockpit</a>
        <a href="#/runner" class="${getNavLinkClass('#/runner')}">🧪 CI Matrix</a>
        <a href="#/settings" class="${getNavLinkClass('#/settings')}">⚙️ Settings</a>
        <a href="#/about" class="${getNavLinkClass('#/about')}">ℹ️ About</a>
      </nav>
    </div>

    <!-- Right Controls: Status & Theme Toggle (Minimal) -->
    <div class="supabase-header-right">
      <div class="supabase-daemon-pill">
        <span class="supabase-dot-pulse"></span>
        <span class="supabase-daemon-text">Daemon :1017</span>
      </div>

      <button class="supabase-theme-toggle" mu-click="toggleTheme()" aria-label="Toggle Theme">
        <span>${getThemeButtonText()}</span>
      </button>
    </div>
  </header>
</mu-template>
<style scoped>
</style>