<mu>
import { muState } from '@mulanjs/mulanjs';
import { RunnerClient } from '../services/runner-client';

const state = muState({
    repoInput: 'enterprise-net/order-api',
    branchInput: 'feature/stripe-payments',
    selectedStackKey: 'dotnet',
    pipelineMode: 'success',
    coverageThreshold: 80,
    running: false,
    terminalLogs: '',
    testResult: null,
    stacks: {
        dotnet: {
            id: 'dotnet',
            name: '.NET 8 / C#',
            framework: 'ASP.NET Core 8 Web API',
            icon: '⚡',
            buildCommand: 'dotnet build --configuration Release',
            testCommand: 'dotnet test --logger "console;verbosity=normal" --collect:"XPlat Code Coverage"',
            coverageEngine: 'Coverlet / Cobertura XML'
        },
        java: {
            id: 'java',
            name: 'Java Spring Boot',
            framework: 'Spring Boot 3.2 / Maven / JUnit 5',
            icon: '☕',
            buildCommand: 'mvn compile',
            testCommand: 'mvn clean test jacoco:report',
            coverageEngine: 'JaCoCo Coverage Engine'
        },
        react: {
            id: 'react',
            name: 'React 18 / TypeScript',
            framework: 'React / Vite / Jest',
            icon: '⚛️',
            buildCommand: 'npm run build',
            testCommand: 'npm test -- --coverage --watchAll=false',
            coverageEngine: 'Jest / Istanbul Coverage'
        },
        angular: {
            id: 'angular',
            name: 'Angular / UI',
            framework: 'Angular 17 / Jasmine / Karma',
            icon: '🅰️',
            buildCommand: 'npm run build',
            testCommand: 'npm run test -- --no-watch --code-coverage',
            coverageEngine: 'Karma / Istanbul Coverage'
        },
        vue: {
            id: 'vue',
            name: 'Vue 3 / Vite',
            framework: 'Vue 3 SFC / Vitest',
            icon: '💚',
            buildCommand: 'npm run build',
            testCommand: 'npx vitest run --coverage',
            coverageEngine: 'Vitest / V8 Coverage'
        },
        python: {
            id: 'python',
            name: 'Python / FastAPI',
            framework: 'FastAPI / Pytest',
            icon: '🐍',
            buildCommand: 'python -m compileall .',
            testCommand: 'pytest --cov=. --cov-report=xml:coverage.xml tests/',
            coverageEngine: 'Coverage.py'
        },
        go: {
            id: 'go',
            name: 'Go',
            framework: 'Go Microservice Toolchain',
            icon: '🐹',
            buildCommand: 'go build ./...',
            testCommand: 'go test -v -coverprofile=coverage.out ./...',
            coverageEngine: 'Go Cover'
        }
    }
});

function selectStack(key) {
    state.selectedStackKey = key;
}

function setPipelineMode(mode) {
    state.pipelineMode = mode;
}

function runPipeline() {
    state.running = true;
    state.terminalLogs = '';
    state.testResult = null;
    
    const currentStack = state.stacks[state.selectedStackKey];
    const detected = {
        language: currentStack.name,
        framework: currentStack.framework,
        icon: currentStack.icon,
        buildCommand: currentStack.buildCommand,
        testCommand: currentStack.testCommand,
        coverageTool: currentStack.coverageEngine,
        confidence: 95
    };

    const onLog = (line) => {
        state.terminalLogs += (state.terminalLogs ? '\n' : '') + line;
    };

    RunnerClient.executeBuildAndTest(state.repoInput, 42, detected, onLog, state.pipelineMode).then((result) => {
        state.testResult = result;
        state.running = false;
    }).catch((err) => {
        onLog('[Error] Pipeline failed: ' + err.message);
        state.running = false;
    });
}

function clearLogs() {
    state.terminalLogs = '';
    state.testResult = null;
}

function getStackBtnClass(key) {
    return 'stack-btn ' + (state.selectedStackKey === key ? 'active' : '');
}

function getModeBtnClass(mode) {
    return 'mu-chip mode-chip ' + (state.pipelineMode === mode ? 'active' : '');
}

function getRunnerButtonClass() {
    return 'mu-btn mu-btn-primary ' + (state.running ? 'btn-scanning' : '');
}

function getTerminalStatusClass() {
    if (state.running) return 'status-tag tag-running';
    if (!state.testResult) return 'status-tag tag-idle';
    return state.testResult.success ? 'status-tag tag-success' : 'status-tag tag-failed';
}

function getTerminalStatusText() {
    if (state.running) return 'RUNNING';
    if (!state.testResult) return 'IDLE';
    return state.testResult.success ? 'COMPLETED' : 'FAILED';
}

function getQualityGateClass() {
    if (!state.testResult) return 'qg-banner';
    return 'qg-banner ' + (state.testResult.qualityGatePassed ? 'qg-passed' : 'qg-failed');
}

function getCoverageFillClass() {
    if (!state.testResult || !state.testResult.coverage) return 'progress-bar-fill fill-green';
    const p = state.testResult.coverage.linesPercentage;
    return 'progress-bar-fill ' + (p >= 80 ? 'fill-green' : (p >= 60 ? 'fill-amber' : 'fill-red'));
}

function getFileCovClass(coverage) {
    if (coverage >= 80) return 'progress-bar-fill fill-green';
    if (coverage >= 60) return 'progress-bar-fill fill-amber';
    return 'progress-bar-fill fill-red';
}

function getFileCovTextClass(coverage) {
    if (coverage >= 80) return 'pct-label text-green';
    if (coverage >= 60) return 'pct-label text-amber';
    return 'pct-label text-red';
}

function getFileStatusBadge(coverage) {
    return coverage >= 80 ? 'qg-status-pill pill-passed' : 'qg-status-pill pill-failed';
}

function getFileStatusText(coverage) {
    return coverage >= 80 ? 'PASSED' : 'FAILED';
}

function getFileBranchCov(f) {
    if (f.branchCoverage) return f.branchCoverage;
    return f.coverage >= 80 ? '88.2%' : '64.0%';
}

function getUncoveredText(f) {
    if (f.uncoveredLines && f.uncoveredLines.length > 0) {
        return 'L' + f.uncoveredLines.join(', L');
    }
    return '100% Covered';
}
</mu>
<mu-template>
  <div class="page container">
    <div class="runner-header">
      <div class="hero-brand-emblem-wrap">
        <svg width="60" height="60" viewBox="0 0 160 160" fill="none" xmlns="http://www.w3.org/2000/svg" class="hero-mulan-logo">
          <!-- Outer Quantum Orbital Ring -->
          <circle cx="80" cy="80" r="74" stroke="#00f0ff" stroke-width="2" stroke-dasharray="10 8" opacity="0.6" class="orbital-ring-outer"></circle>
          <circle cx="80" cy="80" r="62" stroke="#ff2a6d" stroke-width="2" stroke-dasharray="16 10" opacity="0.5" class="orbital-ring-inner"></circle>
          <!-- Quantum Nodes -->
          <circle cx="80" cy="6" r="6" fill="#00f0ff"></circle>
          <circle cx="154" cy="80" r="6" fill="#ff2a6d"></circle>
          <circle cx="80" cy="154" r="6" fill="#9d4edd"></circle>
          <circle cx="6" cy="80" r="6" fill="#ffe600"></circle>
          <!-- Magnolia Blossom Petals Layer 1 -->
          <g class="mulan-petals-1">
            <path d="M80 80 C68 55, 68 26, 80 16 C92 26, 92 55, 80 80 Z" fill="url(#mulanPetalPink)" opacity="0.95"></path>
            <path d="M80 80 C68 105, 68 134, 80 144 C92 134, 92 105, 80 80 Z" fill="url(#mulanPetalPink)" opacity="0.95"></path>
            <path d="M80 80 C55 68, 26 68, 16 80 C26 92, 55 92, 80 80 Z" fill="url(#mulanPetalPink)" opacity="0.95"></path>
            <path d="M80 80 C105 68, 134 68, 144 80 C134 92, 105 92, 80 80 Z" fill="url(#mulanPetalPink)" opacity="0.95"></path>
          </g>
          <!-- Magnolia Blossom Petals Layer 2 -->
          <g transform="rotate(45 80 80)" class="mulan-petals-2">
            <path d="M80 80 C70 58, 70 32, 80 22 C90 32, 90 58, 80 80 Z" fill="url(#mulanPetalCyan)" opacity="0.9"></path>
            <path d="M80 80 C70 102, 70 128, 80 138 C90 128, 90 102, 80 80 Z" fill="url(#mulanPetalCyan)" opacity="0.9"></path>
            <path d="M80 80 C58 70, 32 70, 22 80 C32 90, 58 90, 80 80 Z" fill="url(#mulanPetalCyan)" opacity="0.9"></path>
            <path d="M80 80 C102 70, 128 70, 138 80 C128 90, 102 90, 80 80 Z" fill="url(#mulanPetalCyan)" opacity="0.9"></path>
          </g>
          <!-- Golden Quantum Core with Star -->
          <circle cx="80" cy="80" r="25" fill="#070a13" stroke="#ff2a6d" stroke-width="2.5"></circle>
          <circle cx="80" cy="80" r="19" fill="url(#mulanCoreGlow)"></circle>
          <polygon points="80,65 84,74 93,75 86,82 88,91 80,86 72,91 74,82 67,75 76,74" fill="#ffffff"></polygon>
          <circle cx="80" cy="80" r="4.5" fill="#070a13"></circle>
        </svg>
      </div>
      <div class="hero-badge">⚡ MULANJS QUANTUM PIPELINE RUNNER</div>
      <h1 class="hero-title">Automated Build, Test & Coverage Matrix</h1>
      <p class="hero-subtitle">
        Unlike Copilot which only suggests chat completions, MulanPR downloads your PR code, executes native compiler builds, runs full test suites, and enforces strict organization coverage standards.
      </p>

      <!-- Superiority vs Copilot Highlights -->
      <div class="copilot-diff-grid">
        <div class="diff-card">
          <span class="diff-icon">🚫</span>
          <div class="diff-text">
            <strong>Standard GitHub Copilot:</strong> No repository downloads, cannot compile or execute tests, zero code coverage metrics.
          </div>
        </div>
        <div class="diff-card highlight">
          <span class="diff-icon">⚡</span>
          <div class="diff-text">
            <strong>MulanPR Power Tool:</strong> Automated .NET/Java/UI/Python/Go builds, live test execution, coverage heatmaps & quality gates.
          </div>
        </div>
      </div>
    </div>

    <!-- Tech Stack Selector Grid -->
    <div class="mu-card stack-card">
      <div class="mu-card-title">
        <span>1. Select Repository Technology Stack</span>
      </div>
      <div class="stacks-grid">
        <button 
          class="${getStackBtnClass('dotnet')}"
          mu-click="selectStack('dotnet')"
        >
          <span class="stack-icon">⚡</span>
          <div class="stack-info">
            <span class="stack-name">.NET 8 / C#</span>
            <span class="stack-desc">ASP.NET Core & Coverlet</span>
          </div>
        </button>

        <button 
          class="${getStackBtnClass('java')}"
          mu-click="selectStack('java')"
        >
          <span class="stack-icon">☕</span>
          <div class="stack-info">
            <span class="stack-name">Java Spring Boot</span>
            <span class="stack-desc">Maven / JUnit & JaCoCo</span>
          </div>
        </button>

        <button 
          class="${getStackBtnClass('react')}"
          mu-click="selectStack('react')"
        >
          <span class="stack-icon">⚛️</span>
          <div class="stack-info">
            <span class="stack-name">React 18 / TS</span>
            <span class="stack-desc">Jest / Vitest & Istanbul</span>
          </div>
        </button>

        <button 
          class="${getStackBtnClass('angular')}"
          mu-click="selectStack('angular')"
        >
          <span class="stack-icon">🅰️</span>
          <div class="stack-info">
            <span class="stack-name">Angular / UI</span>
            <span class="stack-desc">Karma & Code Coverage</span>
          </div>
        </button>

        <button 
          class="${getStackBtnClass('vue')}"
          mu-click="selectStack('vue')"
        >
          <span class="stack-icon">💚</span>
          <div class="stack-info">
            <span class="stack-name">Vue 3 / Vite</span>
            <span class="stack-desc">Vitest & V8 Coverage</span>
          </div>
        </button>

        <button 
          class="${getStackBtnClass('python')}"
          mu-click="selectStack('python')"
        >
          <span class="stack-icon">🐍</span>
          <div class="stack-info">
            <span class="stack-name">Python</span>
            <span class="stack-desc">Pytest & Coverage.py</span>
          </div>
        </button>

        <button 
          class="${getStackBtnClass('go')}"
          mu-click="selectStack('go')"
        >
          <span class="stack-icon">🐹</span>
          <div class="stack-info">
            <span class="stack-name">Go</span>
            <span class="stack-desc">Go test toolchain</span>
          </div>
        </button>
      </div>
    </div>

    <!-- Pipeline Configuration Card -->
    <div class="mu-card pipeline-card">
      <div class="mu-card-title">
        <span>2. Pipeline Execution & Outcome Mode</span>
      </div>

      <!-- Execution Mode Switcher -->
      <div class="mode-selection-bar">
        <span class="mode-label">Demonstration / Pipeline Outcome:</span>
        <div class="mode-chips">
          <button 
            class="${getModeBtnClass('success')}"
            mu-click="setPipelineMode('success')"
          >
            🟢 Build Success & High Coverage (92.4%)
          </button>
          <button 
            class="${getModeBtnClass('failure')}"
            mu-click="setPipelineMode('failure')"
          >
            🔴 Simulate Build/Test Failure
          </button>
          <button 
            class="${getModeBtnClass('low-coverage')}"
            mu-click="setPipelineMode('low-coverage')"
          >
            🟡 Simulate Low Coverage (<80%)
          </button>
        </div>
      </div>
      
      <div class="pipeline-fields-grid">
        <div class="form-group">
          <label class="form-label">Repository</label>
          <input 
            type="text" 
            class="form-input" 
            value="${state.repoInput}" 
            mu-input="state.repoInput = $event.target.value" 
          >
        </div>

        <div class="form-group">
          <label class="form-label">PR Branch / Commit Ref</label>
          <input 
            type="text" 
            class="form-input" 
            value="${state.branchInput}" 
            mu-input="state.branchInput = $event.target.value" 
          >
        </div>

        <div class="form-group flex-wide">
          <label class="form-label">Build Command</label>
          <input 
            type="text" 
            class="form-input font-code" 
            value="${state.stacks[state.selectedStackKey].buildCommand}" 
            mu-input="state.stacks[state.selectedStackKey].buildCommand = $event.target.value" 
          >
        </div>

        <div class="form-group flex-wide">
          <label class="form-label">Test & Coverage Command</label>
          <input 
            type="text" 
            class="form-input font-code" 
            value="${state.stacks[state.selectedStackKey].testCommand}" 
            mu-input="state.stacks[state.selectedStackKey].testCommand = $event.target.value" 
          >
        </div>
      </div>

      <div class="pipeline-actions">
        <button 
          class="${getRunnerButtonClass()}"
          mu-click="runPipeline()"
        >
          <span>${state.running ? '⚙️ Executing Build & Tests...' : '🚀 Download & Run Test Pipeline'}</span>
        </button>
        <span class="engine-note">Service target: http://localhost:1017 (Local Runner)</span>
      </div>
    </div>

    <!-- Quality Gate Banner (When Finished) -->
    <div class="${getQualityGateClass()}" mu-if="state.testResult">
      <div class="qg-icon">
        <span mu-if="state.testResult.qualityGatePassed">🏆</span>
        <span mu-if="!state.testResult.qualityGatePassed">🚨</span>
      </div>
      <div class="qg-info">
        <div class="qg-title">
          <span mu-if="state.testResult.qualityGatePassed">Quality Gate PASSED: Ready for Merge</span>
          <span mu-if="!state.testResult.qualityGatePassed">Quality Gate FAILED: Merge Blocked</span>
        </div>
        <div class="qg-reason">${state.testResult.qualityGateReason}</div>
      </div>
      <div class="qg-badge">
        <span>Coverage: ${state.testResult.coverage.linesPercentage}% (Required: ${state.coverageThreshold}%)</span>
      </div>
    </div>

    <!-- Test Run Summary (When Finished) -->
    <div class="test-summary-row" mu-if="state.testResult">
      <div class="summary-pill success">
        <span class="summary-icon">✅</span>
        <div>
          <div class="summary-num">${state.testResult.testsPassed} Passed</div>
          <div class="summary-label">Test cases succeeded</div>
        </div>
      </div>

      <div class="summary-pill failed" mu-if="state.testResult.testsFailed">
        <span class="summary-icon">❌</span>
        <div>
          <div class="summary-num text-red">${state.testResult.testsFailed} Failed</div>
          <div class="summary-label">Assertion errors</div>
        </div>
      </div>

      <div class="summary-pill time">
        <span class="summary-icon">⏱️</span>
        <div>
          <div class="summary-num">${(state.testResult.durationMs / 1000).toFixed(2)}s</div>
          <div class="summary-label">Pipeline Duration</div>
        </div>
      </div>

      <div class="summary-pill coverage">
        <span class="summary-icon">📈</span>
        <div>
          <div class="summary-num">${state.testResult.coverage.linesPercentage}%</div>
          <div class="summary-label">Line Code Coverage</div>
        </div>
      </div>
    </div>

    <!-- Live Terminal Logs -->
    <div class="terminal-window">
      <div class="terminal-header">
        <div class="terminal-dots">
          <span class="terminal-dot dot-red"></span>
          <span class="terminal-dot dot-yellow"></span>
          <span class="terminal-dot dot-green"></span>
          <span class="terminal-title">Runner Console (Port 1017)</span>
        </div>
        <div class="terminal-actions">
          <span class="${getTerminalStatusClass()}">
            ${getTerminalStatusText()}
          </span>
          <button class="mu-btn mu-btn-sm mu-btn-secondary term-btn" mu-click="clearLogs()">Clear</button>
        </div>
      </div>
      <div class="terminal-body">
        <div class="terminal-placeholder" mu-if="!state.terminalLogs">
          Click "Download & Run Test Pipeline" above to execute build, unit tests, and coverage analysis.
        </div>
        <pre class="terminal-text" mu-if="state.terminalLogs">${state.terminalLogs}</pre>
      </div>
    </div>

    <!-- Coverage Report Component -->
    <div class="coverage-panel" mu-if="state.testResult && state.testResult.coverage">
      <div class="coverage-header">
        <div class="coverage-title">
          <span>📊 Code Coverage Analysis Report</span>
          <span class="coverage-badge">${state.testResult.coverage.linesPercentage}% Total</span>
        </div>
        <div class="coverage-counts">
          ${state.testResult.coverage.coveredLines} / ${state.testResult.coverage.totalLines} lines covered
        </div>
      </div>

      <div class="cov-metrics-grid">
        <div class="cov-metric-box">
          <div class="cov-label">Lines</div>
          <div class="cov-num text-green">${state.testResult.coverage.linesPercentage}%</div>
          <div class="progress-bar-bg">
            <div class="${getCoverageFillClass()}" style="width: ${state.testResult.coverage.linesPercentage}%"></div>
          </div>
        </div>

        <div class="cov-metric-box">
          <div class="cov-label">Branches</div>
          <div class="cov-num text-amber">${state.testResult.coverage.branchPercentage}%</div>
          <div class="progress-bar-bg">
            <div class="progress-bar-fill fill-amber" style="width: ${state.testResult.coverage.branchPercentage}%"></div>
          </div>
        </div>

        <div class="cov-metric-box">
          <div class="cov-label">Functions</div>
          <div class="cov-num text-cyan">${state.testResult.coverage.functionsPercentage}%</div>
          <div class="progress-bar-bg">
            <div class="progress-bar-fill fill-brand" style="width: ${state.testResult.coverage.functionsPercentage}%"></div>
          </div>
        </div>

        <div class="cov-metric-box">
          <div class="cov-label">Engine</div>
          <div class="cov-num text-green">${state.stacks[state.selectedStackKey].coverageEngine.split(' ')[0]}</div>
          <div class="cov-subtext">${state.stacks[state.selectedStackKey].framework}</div>
        </div>
      </div>

      <!-- File Drilldown Enterprise Table -->
      <div class="cov-table-card">
        <div class="cov-table-header-title">
          <span>Detailed Code Coverage by Module / File</span>
          <span class="cov-files-count">${state.testResult.coverage.files ? state.testResult.coverage.files.length : 0} Files Monitored</span>
        </div>
        <div class="cov-table-wrapper">
          <table class="cov-enterprise-table">
            <thead>
              <tr>
                <th class="th-file">Source File / Module</th>
                <th class="th-lines">Lines Covered / Total</th>
                <th class="th-uncovered">Uncovered PR Lines</th>
                <th class="th-coverage">Line Coverage</th>
                <th class="th-branch">Branch %</th>
                <th class="th-status">Quality Gate</th>
              </tr>
            </thead>
            <tbody>
              <tr mu-for="f in state.testResult.coverage.files" class="cov-table-row">
                <td class="td-file">
                  <div class="file-name-cell">
                    <span class="file-icon">📄</span>
                    <span class="file-path font-mono">${f.filename}</span>
                  </div>
                </td>
                <td class="td-lines font-mono">
                  ${f.coveredLines || Math.round((f.totalLines || 120) * (f.coverage / 100))} / ${f.totalLines || 120}
                </td>
                <td class="td-uncovered">
                  <span class="uncovered-tag" mu-if="f.uncoveredLines">
                    ${getUncoveredText(f)}
                  </span>
                  <span class="covered-tag" mu-if="!f.uncoveredLines">
                    ✅ 100% Covered
                  </span>
                </td>
                <td class="td-coverage">
                  <div class="cov-cell-progress">
                    <div class="progress-bar-bg table-bar">
                      <div class="${getFileCovClass(f.coverage)}" style="width: ${f.coverage}%"></div>
                    </div>
                    <span class="${getFileCovTextClass(f.coverage)}">${f.coverage}%</span>
                  </div>
                </td>
                <td class="td-branch font-mono">
                  ${getFileBranchCov(f)}
                </td>
                <td class="td-status">
                  <span class="${getFileStatusBadge(f.coverage)}">${getFileStatusText(f.coverage)}</span>
                </td>
              </tr>
            </tbody>
            <tfoot>
              <tr class="cov-table-footer">
                <td class="td-file font-bold">Total Repository Scope</td>
                <td class="td-lines font-mono font-bold">${state.testResult.coverage.coveredLines} / ${state.testResult.coverage.totalLines}</td>
                <td class="td-uncovered text-muted">All active PR changes evaluated</td>
                <td class="td-coverage">
                  <span class="font-bold text-green">${state.testResult.coverage.linesPercentage}% Overall</span>
                </td>
                <td class="td-branch font-mono font-bold">${state.testResult.coverage.branchPercentage}%</td>
                <td class="td-status">
                  <span class="${state.testResult.qualityGatePassed ? 'qg-status-pill pill-passed' : 'qg-status-pill pill-failed'}">
                    ${state.testResult.qualityGatePassed ? 'PASSED' : 'BLOCKED'}
                  </span>
                </td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>
  </div>
</mu-template>
<style scoped>
.runner-header {
  text-align: center;
  padding: 30px 10px 20px;
}
.copilot-diff-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  max-width: 900px;
  margin: 18px auto 0;
}
.diff-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 18px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 8px;
  font-size: 0.85rem;
  color: #94a3b8;
  text-align: left;
}
.diff-card.highlight {
  background: rgba(0, 240, 255, 0.06);
  border-color: rgba(0, 240, 255, 0.3);
  color: #e2e8f0;
}
.diff-icon {
  font-size: 1.4rem;
}
.stack-card {
  margin-bottom: 24px;
}
.stacks-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 12px;
}
.stack-btn {
